# 目标平台及设备配置 (京东云亚瑟 AX1800 Pro)
CONFIG_TARGET_ipq60xx=y
CONFIG_TARGET_ipq60xx_generic=y
CONFIG_TARGET_ipq60xx_generic_DEVICE_jdcloud_re-ss-01=y

# 核心管理界面与语言包 (只保留最基本的网页和中文，绝不臃肿)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 核心推荐插件 (AdGuardHome + Docker + UPnP + WOL)
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# 新增的实用功能插件 (Samba4 + ZeroTier + TurboACC + TTYD + iStore应用商店)
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-store=y

# 高颜值 Argon 主题及配置后台 + 官方 Material 质感主题
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-material=y

# 网页端磁盘管理与可视化分区工具 (Diskman) + 网页内嵌极简文件助手 (QuickFile) + 快速设置向导与网络大盘总览 (QuickStart)
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_luci-app-quickstart=y

# 使用宿主机预装的 Clang/LLVM 编译 BPF 字节码，免去本地编译 tools/llvm-bpf 消耗 2 小时的过程
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH="/usr"
