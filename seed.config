# 目标平台及设备配置 (京东云亚瑟 AX1800 Pro)
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# 核心管理界面与语言包 (只保留最基本的网页和中文，绝不臃肿)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y

# 核心推荐插件 (AdGuardHome + UPnP + WOL)
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# 实用功能插件 (Samba4 + ZeroTier + TTYD)
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-ttyd=y

# 高颜值 Argon 主题及配置后台 + 官方 Material 质感主题
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-material=y

# 网页端磁盘管理与文件管理
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-filemanager=y

# 使用宿主机预装的 Clang/LLVM 编译 BPF 字节码，免去本地编译 tools/llvm-bpf 消耗 2 小时的过程
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH="/usr"

# 核心磁盘挂载与系统盘扩容依赖
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y

# 实用系统工具 (磁盘健康检测 + 自动挂载 + 分区查看 + 环回设备 + CPU 调频)
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_cpufreq=y

# 文件系统支持 (NTFS + Btrfs + 中文文件名)
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_kmod-nls-cp936=y

# 网络体验 (流量监控 + 智能队列 + 局域网测速 + 动态域名 + 中断均衡)
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_irqbalance=y

# SSH 实用工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_openssh-sftp-server=y

# 网络稳定性 (断网自动重启/重拨)
CONFIG_PACKAGE_luci-app-watchcat=y
